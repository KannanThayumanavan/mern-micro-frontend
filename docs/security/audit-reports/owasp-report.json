@dataclass
class Dependency:
    file_path: str
    file_name: str
    sha256: str
    sha1: str
    md5: str
    package_name: str
    package_version: str
    package_ecosystem: str
    workspace: str
    description: Optional[str]
    license: Optional[str]
    vulnerabilities: list[Vulnerability]
    vulnerability_count: int = field(init=False)
    highest_severity: str = field(init=False)

    def __post_init__(self):
        self.vulnerability_count = len(self.vulnerabilities)
        severity_order = [
            Severity.CRITICAL,
            Severity.HIGH,
            Severity.MEDIUM,
            Severity.LOW,
            Severity.INFO,
            Severity.NONE,
        ]
        if self.vulnerabilities:
            severities = [v.severity for v in self.vulnerabilities]
            for sev in severity_order:
                if sev.value in severities:
                    self.highest_severity = sev.value
                    break
            else:
                self.highest_severity = Severity.NONE.value
        else:
            self.highest_severity = Severity.NONE.value


